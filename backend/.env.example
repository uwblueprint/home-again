# Backend environment configuration
# Copy this file to .env and fill in your values. See docs/ONBOARDING.md for setup.
# All keys match Settings in app/config.py.

# Environment
# DEVELOPMENT: requests with no bearer token act as DEV_USER_ID, so you can use the
# API locally without Supabase. Tokens that are sent are still verified.
# Requires DEBUG=True. Never set this in production (the default is PRODUCTION).
ENV=DEVELOPMENT
# Supabase user ID that tokenless requests act as. To test role checks, set this
# to the supabase_user_id of an admins or agents row in your local database.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@example.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hafb

# Supabase (optional — used once JWT verification is wired up)
# Base URL of the Supabase project, e.g. https://<project-ref>.supabase.co (not secret)
SUPABASE_URL=

# Supabase API key (anon/service). Leave blank for local until auth is configured.
SUPABASE_KEY=

# URL of the public key set the backend uses to verify JWT signatures.
# Usually <SUPABASE_URL>/auth/v1/.well-known/jwks.json (not secret)
SUPABASE_JWKS_URL=

# Expected "aud" claim in access tokens. Supabase uses "authenticated" for logged-in users.
SUPABASE_JWT_AUDIENCE=authenticated

# API
API_HOST=0.0.0.0
API_PORT=8000
# True locally so /docs and /openapi.json stay available. Keep False in production.
DEBUG=True

# CORS — JSON list of allowed origins (matches Settings.CORS_ORIGINS default)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# JWT (app signing — separate from Supabase token verification)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
